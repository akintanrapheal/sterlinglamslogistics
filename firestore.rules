rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Sterling Glams Logistics — Firestore security rules
//
// These rules require server-side access to use firebase-admin, which bypasses
// rules. That migration is COMPLETE and was re-verified: every route under
// app/(app)/api/** imports adminDb or lib/server/firestore-admin, and none
// imports the client-SDK helpers in lib/firestore.ts.
//
// The client SDK is still used, but only from admin dashboard pages (orders,
// drivers, dispatch, dashboard, reports, reviews, routes) where the user is
// signed in with the `admin` claim, so isAdmin() is satisfied. Drivers
// authenticate with a custom session rather than Firebase Auth and therefore
// have request.auth == null — they must never read Firestore directly from the
// client; their data comes from /api/driver/** instead. OrderAlertProvider
// wraps the whole (app) group but guards its subscription on a signed-in
// Firebase user, so it stays inert on driver and public tracking pages.
//
// Deploy with:   firebase deploy --only firestore:rules
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Matches the role claim set by set-admin-claim.mjs / admin SDK
    function hasRole(r) {
      return isSignedIn() && request.auth.token.role == r;
    }

    function isAdminOrOwner() {
      return isAdmin() || hasRole("admin") || hasRole("owner");
    }

    // ── Orders ────────────────────────────────────────────────────────────────
    // Customer tracking page now uses /api/track/[tracking] (server-side admin
    // SDK) so unauthenticated clients no longer need direct Firestore access.
    // Admin dashboard reads are authenticated via Firebase Auth + admin claim.
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdminOrOwner();
    }

    // ── Drivers ───────────────────────────────────────────────────────────────
    // Tracking page now fetches driver data through /api/track/[tracking] which
    // strips password, phone, and email before returning. Admin SDK bypasses
    // these rules so all server-side routes continue to work.
    //
    // ⚠️ REMAINING RISK: Password hashes still live on driver documents.
    // Recommended long-term fix: move credentials to a private
    // `driverCredentials/{driverId}` subcollection with `allow read, write: if false`.
    match /drivers/{driverId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ── Settings ──────────────────────────────────────────────────────────────
    // ⚠️ These rules previously used a blanket `match /settings/{document=**}`
    // with `allow read: if true`. That exposed settings/integrationSettings —
    // which holds API keys and webhook secrets — to anyone with the project ID,
    // and the project ID ships in the public client bundle. Any secret that was
    // stored there before this change must be treated as compromised and
    // rotated.
    //
    // Branding is the only genuinely public part: customer-facing pages may need
    // the business name and logo with no authenticated session. Note that
    // Firestore grants access if ANY matching rule allows it, so the specific
    // public rules below widen read access only for those two documents.
    match /settings/businessSettings {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/brandSettings {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Everything else — integrations, dispatch, routing, driver flags,
    // notification config — is admin-only in both directions. Server routes use
    // the admin SDK, which bypasses these rules, so they are unaffected.
    match /settings/{document} {
      allow read, write: if isAdmin();
    }

    // ── Notification logs ─────────────────────────────────────────────────────
    // Operational data — admin-only in both directions.
    match /notificationLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ── Audit logs ────────────────────────────────────────────────────────────
    // Tamper-evident: admin can read; nobody (incl. admin) writes from clients.
    // Server writes via admin SDK which bypasses these rules.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Admins collection (mapping uid → role) ────────────────────────────────
    match /admins/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // ── Driver live locations (public tracking) ───────────────────────────────
    // Only exposes lat/lng/updatedAt — no name, phone, email, or password.
    // Written server-side only (admin SDK bypasses these rules).
    match /driverLocations/{driverId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Default deny ──────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
