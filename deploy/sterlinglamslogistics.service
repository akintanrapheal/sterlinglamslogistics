[Unit]
Description=sterlinglamslogistics (Next.js)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/sterlinglamslogistics
# Run Next directly via node so there is no pnpm/PATH dependency under systemd.
# Next loads the .env file from WorkingDirectory automatically (public vars are
# already baked in at build; server vars are read here at runtime).
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3000
Environment=NODE_ENV=production
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
