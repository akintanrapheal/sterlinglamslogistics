# sterlinglamslogistics — environment variables
# Copy to ".env" on the server and fill in the values from your Vercel project
# (Vercel → Project → Settings → Environment Variables). NEXT_PUBLIC_* values are
# baked in at build time; the rest are read at runtime.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Public app config (inlined at build — must be present when you run `pnpm build`)
NEXT_PUBLIC_SITE_ORIGIN=https://your-domain.com
NEXT_PUBLIC_API_BASE_URL=https://your-domain.com
NEXT_PUBLIC_HUB_LAT=
NEXT_PUBLIC_HUB_LNG=

# ── Firebase (client / public) ─────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (server) — the full service-account JSON on ONE line ─────
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── Google Maps ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ── Secrets ─────────────────────────────────────────────────────────────────
CRON_SECRET=            # also used by the daily audit-log cron (see deploy/ORACLE_SETUP.md)
DRIVER_SESSION_SECRET=
STORE_WEBHOOK_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=

# ── Twilio (SMS + WhatsApp) ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_WHATSAPP_CONTENT_SID_ORDER_ACCEPTED=
TWILIO_WHATSAPP_CONTENT_SID_OUT_FOR_DELIVERY=
TWILIO_WHATSAPP_CONTENT_SID_DELIVERED=

# ── Upstash Redis (rate limiting / cache) ───────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Outbound webhook to the store ───────────────────────────────────────────
STORE_DELIVERED_WEBHOOK_URL=

# ── Retention / logging (optional; have sensible defaults) ──────────────────
AUDIT_LOG_RETENTION_DAYS=
DRIVER_TRAIL_RETENTION_DAYS=
LOG_LEVEL=info

# ── Sentry (build-time only; optional) ──────────────────────────────────────
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
